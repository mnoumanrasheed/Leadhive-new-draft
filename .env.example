# LeadHive AI — Environment Variables Template
# Copy this file to `.env` or `.env.local` for local development.
# IMPORTANT: Never commit actual secret keys or credentials to Git.

# Application Configuration
VITE_APP_TITLE="LeadHive AI — Autonomous Sales Intelligence Platform"
VITE_SITE_URL="https://leadhive-ai.com"
